<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-semibold text-gray-800">Organisations</h1>
    <% if current_user.has_role?(:admin) %>
      <%= link_to "New Organisation", new_organisation_path, class: "inline-flex items-center px-3 py-1 text-sm rounded bg-indigo-600 text-white hover:bg-indigo-700" %>
    <% end %>
  </div>
  <div class="bg-white shadow-sm rounded-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Users</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Present Now</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Working Hours</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @organisations.each do |org| %>
          <% summary = @presence_summary[org.id] %>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap"><%= org.name %></td>
            <td class="px-4 py-2 whitespace-nowrap"><%= summary[:users_count] %></td>
            <td class="px-4 py-2 whitespace-nowrap">
              <span class="inline-flex items-center px-2 py-1 rounded bg-green-100 text-green-800"><%= summary[:present_count] %></span>
            </td>
            <td class="px-4 py-2 whitespace-nowrap">
              <span><%= org.work_start_time.strftime('%H:%M') %>–<%= org.work_end_time.strftime('%H:%M') %></span>
            </td>
            <td class="px-4 py-2 whitespace-nowrap text-right">
              <%= link_to "View", organisation_path(org), class: "px-3 py-1 text-sm rounded bg-blue-600 text-white hover:bg-blue-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="flex items-center justify-between text-sm text-gray-700">
    <div>
      Showing <%= @start_count %>–<%= @end_count %> of <%= @total_count %>
    </div>
    <div class="flex items-center gap-2">
      <% prev_disabled = (@page <= 1) || (@total_pages == 0) %>
      <% next_disabled = (@total_pages == 0) || (@page >= @total_pages) %>
      <% if prev_disabled %>
        <span class="px-3 py-1 rounded border bg-gray-100 text-gray-400 cursor-not-allowed">Back</span>
      <% else %>
        <%= link_to "Back", organisations_path(page: @page - 1), class: "px-3 py-1 rounded border bg-white text-gray-700 hover:bg-gray-50" %>
      <% end %>
      <% if next_disabled %>
        <span class="px-3 py-1 rounded border bg-gray-100 text-gray-400 cursor-not-allowed">Next</span>
      <% else %>
        <%= link_to "Next", organisations_path(page: @page + 1), class: "px-3 py-1 rounded border bg-white text-gray-700 hover:bg-gray-50" %>
      <% end %>
    </div>
  </div>
</div>
