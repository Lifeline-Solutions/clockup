<div class="space-y-6">
  <h1 class="text-xl font-semibold text-gray-800">Organisations</h1>
  <div class="bg-white shadow-sm rounded-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Users</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Present Now</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Working Hours</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @organisations.each do |org| %>
          <% summary = @presence_summary[org.id] %>
          <tr>
            <td class="px-4 py-2 whitespace-nowrap"><%= org.name %></td>
            <td class="px-4 py-2 whitespace-nowrap"><%= summary[:users_count] %></td>
            <td class="px-4 py-2 whitespace-nowrap">
              <span class="inline-flex items-center px-2 py-1 rounded bg-green-100 text-green-800"><%= summary[:present_count] %></span>
            </td>
            <td class="px-4 py-2 whitespace-nowrap">
              <span><%= org.work_start_time.strftime('%H:%M') %>–<%= org.work_end_time.strftime('%H:%M') %></span>
            </td>
            <td class="px-4 py-2 whitespace-nowrap text-right">
              <%= link_to "View", organisation_path(org), class: "px-3 py-1 text-sm rounded bg-blue-600 text-white hover:bg-blue-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
