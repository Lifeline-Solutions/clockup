<div class="space-y-8">
  <!-- Organisation Summary -->
  <section class="bg-white shadow-sm rounded-lg p-6">
    <div class="flex items-center justify-between">
      <h1 class="text-xl font-semibold text-gray-800"><%= @organisation.name %></h1>
      <% if current_user.has_role?(:admin) || current_user.has_role?(:admin, @organisation) %>
        <%= link_to "Edit", edit_organisation_path(@organisation), class: "inline-flex items-center px-3 py-1 text-sm rounded bg-indigo-600 text-white hover:bg-indigo-700" %>
      <% end %>
    </div>
    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-sm text-gray-700">
      <div class="border rounded-md p-3">
        <div class="font-medium text-gray-900">Location</div>
        <div>Lat: <%= @organisation.latitude %>, Lng: <%= @organisation.longitude %></div>
      </div>
      <div class="border rounded-md p-3">
        <div class="font-medium text-gray-900">Allowed Radius</div>
        <div><%= @organisation.allowed_radius_meters %> meters</div>
      </div>
      <div class="border rounded-md p-3">
        <div class="font-medium text-gray-900">Working Hours</div>
        <div>Start: <%= @organisation.work_start_time.strftime('%H:%M') %></div>
        <div>End: <%= @organisation.work_end_time.strftime('%H:%M') %></div>
      </div>
      <div class="border rounded-md p-3">
        <div class="font-medium text-gray-900">QR Token</div>
        <div class="font-mono"><%= @organisation.clock_qr_token&.gsub(/.(?=.{4})/, '*') %></div>
      </div>
      <div class="border rounded-md p-3">
        <div class="font-medium text-gray-900">Currently Clocked In</div>
        <div>
          <% present_count = @organisation.users.count { |u| (@latest_events[u.id]&.clock_in?) } %>
          <span class="inline-flex items-center px-2 py-1 rounded bg-green-100 text-green-800"><%= present_count %></span>
        </div>
      </div>
      <% if current_user.has_role?(:admin) || current_user.has_role?(:admin, @organisation) %>
        <div class="border rounded-md p-3">
          <div class="font-medium text-gray-900">Manage Users</div>
          <div class="mt-2">
            <%= link_to "Create User", new_organisation_user_path(@organisation), class: "inline-flex items-center px-3 py-1 text-sm rounded bg-indigo-600 text-white hover:bg-indigo-700" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Users Table -->
  <section class="bg-white shadow-sm rounded-lg p-6">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-800">Users</h2>
    </div>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Latest Event</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Distance</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Flags</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @organisation.users.each do |user| %>
            <% evt = @latest_events[user.id] %>
            <tr>
              <td class="px-4 py-2 whitespace-nowrap"><%= user.name.presence || user.email %></td>
              <td class="px-4 py-2 whitespace-nowrap"><%= user.email %></td>
              <td class="px-4 py-2 whitespace-nowrap">
                <% if evt&.clock_in? %>
                  <span class="inline-flex items-center px-2 py-1 rounded bg-green-100 text-green-800">🟢 Clocked in</span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-1 rounded bg-red-100 text-red-800">🔴 Clocked out</span>
                <% end %>
              </td>
              <td class="px-4 py-2 whitespace-nowrap">
                <% if evt %>
                  <div class="text-gray-700"><%= evt.event_type.humanize %></div>
                  <div class="text-gray-500"><%= l(evt.occurred_at, format: :short) %></div>
                <% else %>
                  <span class="text-gray-400">No events</span>
                <% end %>
              </td>
              <td class="px-4 py-2 whitespace-nowrap">
                <% if evt&.distance_from_org_meters %>
                  <%= evt.distance_from_org_meters %> m
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <td class="px-4 py-2 whitespace-nowrap">
                <% if evt&.late? %>
                  <span class="inline-flex items-center px-2 py-1 rounded bg-yellow-100 text-yellow-800">Late today</span>
                <% end %>
                <% if evt&.early_leave? %>
                  <span class="inline-flex items-center px-2 py-1 rounded bg-purple-100 text-purple-800">Left early</span>
                <% end %>
              </td>
              <td class="px-4 py-2 whitespace-nowrap text-right">
                <div class="flex gap-2 justify-end">
                  <% if current_user.has_role?(:admin) || current_user.has_role?(:admin, @organisation) || user == current_user %>
                    <% clocked_in = evt&.clock_in? %>
                    <%= button_to "Clock in",
                                  clock_events_path,
                                  method: :post,
                                  params: { organisation_id: @organisation.id, user_id: user.id, event_type: 'clock_in' },
                                  disabled: clocked_in,
                                  class: [
                                    "px-3 py-1 text-sm rounded",
                                    clocked_in ? "bg-green-300 text-white opacity-50 cursor-not-allowed" : "bg-green-600 text-white hover:bg-green-700"
                                  ].join(" ") %>
                    <%= button_to "Clock out",
                                  clock_events_path,
                                  method: :post,
                                  params: { organisation_id: @organisation.id, user_id: user.id, event_type: 'clock_out' },
                                  disabled: !clocked_in,
                                  class: [
                                    "px-3 py-1 text-sm rounded",
                                    (!clocked_in) ? "bg-red-300 text-white opacity-50 cursor-not-allowed" : "bg-red-600 text-white hover:bg-red-700"
                                  ].join(" ") %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Today's Clock Events -->
  <section class="bg-white shadow-sm rounded-lg p-6">
    <h2 class="text-lg font-semibold text-gray-800">Today's Clock Events</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Distance</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Flags</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @todays_events.each do |evt| %>
            <tr>
              <td class="px-4 py-2 whitespace-nowrap"><%= evt.user.name.presence || evt.user.email %></td>
              <td class="px-4 py-2 whitespace-nowrap"><%= evt.event_type.humanize %></td>
              <td class="px-4 py-2 whitespace-nowrap"><%= l(evt.occurred_at, format: :short) %></td>
              <td class="px-4 py-2 whitespace-nowrap">
                <% if evt&.distance_from_org_meters %>
                  <%= evt.distance_from_org_meters %> m
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <td class="px-4 py-2 whitespace-nowrap">
                <% if evt.late? %>
                  <span class="inline-flex items-center px-2 py-1 rounded bg-yellow-100 text-yellow-800">Late</span>
                <% end %>
                <% if evt.early_leave? %>
                  <span class="inline-flex items-center px-2 py-1 rounded bg-purple-100 text-purple-800">Early</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
